PubNInt1D[integrand_,var_Symbol,lo_,hi_,pts_:{}]:=Module[{loN=N[lo],hiN=N[hi],\
p,it},If[!NumericQ[loN]||!NumericQ[hiN]||hiN<=loN,Return[0.]];p=\
PubInteriorPoints[loN,hiN,Flatten@{pts}];it=Join[{var,loN},p,{hiN}];\
