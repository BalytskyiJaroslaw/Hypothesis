,0.];OnShellPiGammaSpectrumPureVB[t_?NumericQ,y_?NumericQ]:=If[m\[Pi]^2<=t<M\
\[Eta]Prime^2,piGammaMultiplicity*phasePrefactor[M\[Eta]Prime]*\
OnShellPureInner[t,y],0.]; \
